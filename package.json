{
  "name": "serviceform-prospecting-playbook",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "build:signup": "npm --prefix apps/sales-partner-signup run build",
    "build:internal-plan": "npm --prefix apps/sales-partner-internal-plan run build",
    "build:resource-hub": "npm --prefix apps/sales-partner-resource-hub run build",
    "build:ecommerce-deck": "npm --prefix apps/ecommerce-sales-partner-deck run build",
    "check": "npm run build && npm --prefix apps/sales-partner-signup run check && npm --prefix apps/sales-partner-internal-plan run check && npm --prefix apps/sales-partner-resource-hub run check && npm --prefix apps/ecommerce-sales-partner-deck run check",
    "deploy:preview": "npx --yes vercel",
    "deploy:production": "npx --yes vercel --prod"
  },
  "devDependencies": {
    "vite": "latest"
  }
}
